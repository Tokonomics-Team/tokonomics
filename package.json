{
  "name": "tokonomics-ai",
  "displayName": "Tokonomics — AI Context Efficiency for VS Code",
  "description": "A local context-compilation and token-analysis extension for VS Code. Optimization results vary by task, model, and workspace.",
  "version": "8.4.0",
  "publisher": "tokonomics",
  "license": "SEE LICENSE IN LICENSE.txt",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "keywords": [
    "token optimizer",
    "ai cost reduction",
    "prompt compression",
    "token savings",
    "claude caching",
    "copilot optimizer",
    "gpt-4o savings",
    "deepseek optimizer",
    "gemini token savings",
    "context window management",
    "llm cost optimizer",
    "ai token counter",
    "prompt minifier",
    "code context compression",
    "prompt cache alignment",
    "ai finops",
    "ast code pruner",
    "mcp tool compression",
    "cursor token optimizer",
    "chatgpt cost reduction"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Tokonomics-Team/tokonomics"
  },
  "homepage": "https://tokonomics-team.github.io/tokonomics",
  "bugs": {
    "url": "https://github.com/Tokonomics-Team/tokonomics/issues"
  },
  "qna": "https://github.com/Tokonomics-Team/tokonomics/discussions",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/badge/Processing-Local%20Compiler-success.svg",
      "href": "https://tokonomics-team.github.io/tokonomics#privacy",
      "description": "Local context compilation; prompts are sent to the selected upstream model provider"
    },
    {
      "url": "https://img.shields.io/badge/Benchmarks-Controlled%20Synthetic-yellow.svg",
      "href": "https://tokonomics-team.github.io/tokonomics#benchmarks",
      "description": "Controlled synthetic benchmark results; production savings are not yet certified"
    }
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Tokonomics remains available for explicit prompt text, but workspace indexing, file reads, and automatic context attachment are disabled in Restricted Mode.",
      "restrictedConfigurations": [
        "tokenOptimizer.workspaceContext",
        "tokenOptimizer.includeUnsavedChanges"
      ]
    },
    "virtualWorkspaces": false
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:tokonomics.chatEditor"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "tokonomics",
        "displayName": "Tokonomics Context Compiler (Token-Optimized)"
      }
    ],
    "chatParticipants": [
      {
        "id": "token-optimizer-participant",
        "name": "tokonomics",
        "fullName": "Tokonomics",
        "description": "Tokonomics: AI context efficiency and usage visibility for VS Code",
        "isSticky": true,
        "commands": [
          {
            "name": "dashboard",
            "description": "Open usage, context efficiency and request diagnostics"
          },
          {
            "name": "live",
            "description": "View live session token efficiency stream and cost metrics"
          },
          {
            "name": "explain",
            "description": "Review the latest context decision"
          },
          {
            "name": "map",
            "description": "Create a concise workspace overview"
          },
          {
            "name": "pack",
            "description": "Prepare selected workspace files for AI use"
          },
          {
            "name": "stats",
            "description": "Show token savings and ROI metrics"
          },
          {
            "name": "ram",
            "description": "Show in-memory RAM cache, symbol index, and memory budget metrics"
          },
          {
            "name": "logs",
            "description": "View and export bounded, locally sanitized diagnostic logs and crash report"
          },
          {
            "name": "analyze",
            "description": "Analyze active editor file for token redundancy"
          },
          {
            "name": "compact",
            "description": "Compact code or prompt context"
          },
          {
            "name": "codex",
            "description": "Answer with compiled context using your Codex CLI subscription login"
          },
          {
            "name": "claude",
            "description": "Answer with compiled context using your Claude Code CLI subscription login"
          }
        ]
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "tokonomicsChat",
          "title": "Tokonomics",
          "icon": "assets/icon-128.png"
        }
      ]
    },
    "views": {
      "tokonomicsChat": [
        {
          "id": "tokenOptimizer.chatView",
          "name": "Chat",
          "type": "webview",
          "contextualTitle": "Tokonomics Chat",
          "when": "tokonomics.chatSurfaceEnabled"
        }
      ]
    },
    "commands": [
      {
        "command": "tokenOptimizer.openChat",
        "title": "Tokonomics: Open Chat",
        "category": "Tokonomics",
        "enablement": "tokonomics.chatSurfaceEnabled"
      },
      {
        "command": "tokenOptimizer.openChatInEditor",
        "title": "Tokonomics: Open Chat in Editor",
        "category": "Tokonomics",
        "enablement": "tokonomics.chatSurfaceEnabled"
      },
      {
        "command": "tokenOptimizer.showDashboard",
        "title": "Tokonomics: Show Savings Dashboard",
        "category": "Tokonomics"
      },
      {
        "command": "tokenOptimizer.runContextXray",
        "title": "Tokonomics: Run Context X-Ray",
        "category": "Tokonomics",
        "enablement": "tokonomics.insights.contextXrayEnabled"
      },
      {
        "command": "tokenOptimizer.startContextMeter",
        "title": "Tokonomics: Start Context Meter",
        "category": "Tokonomics",
        "enablement": "tokonomics.insights.contextMeterEnabled && !tokonomics.insights.contextMeterActive"
      },
      {
        "command": "tokenOptimizer.stopContextMeter",
        "title": "Tokonomics: Stop Context Meter",
        "category": "Tokonomics",
        "enablement": "tokonomics.insights.contextMeterEnabled && tokonomics.insights.contextMeterActive"
      },
      {
        "command": "tokenOptimizer.auditSessionHealth",
        "title": "Tokonomics: Analyze Session Log Health",
        "category": "Tokonomics",
        "enablement": "tokonomics.insights.sessionHealthEnabled"
      },
      {
        "command": "tokenOptimizer.exportSessionHandoff",
        "title": "Tokonomics: Create Chat Handoff",
        "category": "Tokonomics",
        "enablement": "tokonomics.insights.sessionHandoffEnabled && tokonomics.chatSurfaceEnabled"
      },
      {
        "command": "tokenOptimizer.auditToolSchema",
        "title": "Tokonomics: Audit Tool-Schema Overhead",
        "category": "Tokonomics",
        "enablement": "tokonomics.insights.toolSchemaAuditEnabled"
      },
      {
        "command": "tokenOptimizer.runFirstContextCheck",
        "title": "Tokonomics: Run First Context Check",
        "category": "Tokonomics",
        "enablement": "tokonomics.insights.firstContextCheckEnabled"
      },
      {
        "command": "tokenOptimizer.showAnalyticsWebview",
        "title": "Tokonomics: Open Visual Analytics Webview",
        "category": "Tokonomics"
      },
      {
        "command": "tokenOptimizer.comparePrunedDiff",
        "title": "Tokonomics: Compare Original vs Pruned Skeleton (Side-by-Side Diff)",
        "category": "Tokonomics"
      },
      {
        "command": "tokenOptimizer.optimizeSelection",
        "title": "Tokonomics: Optimize & Copy Selection as Context",
        "category": "Tokonomics"
      },
      {
        "command": "tokenOptimizer.toggleAstPruning",
        "title": "Tokonomics: Toggle AST Structural Pruning",
        "category": "Tokonomics"
      },
      {
        "command": "tokenOptimizer.resetMetrics",
        "title": "Tokonomics: Reset Session Savings Metrics",
        "category": "Tokonomics"
      },
      {
        "command": "tokenOptimizer.exportLogs",
        "title": "Tokonomics: Export Anonymized Diagnostic Logs",
        "category": "Tokonomics"
      },
      {
        "command": "tokenOptimizer.liveStats",
        "title": "Tokonomics: Show Live Session Savings",
        "category": "Tokonomics"
      },
      {
        "command": "tokenOptimizer.aggregateStats",
        "title": "Tokonomics: Open Aggregated Savings Ledger",
        "category": "Tokonomics"
      },
      {
        "command": "tokenOptimizer.explainTrace",
        "title": "Tokonomics: Inspect Compiler Decision Trace",
        "category": "Tokonomics"
      },
      {
        "command": "tokenOptimizer.manageProjectMemory",
        "title": "Tokonomics: Manage Project Memory",
        "category": "Tokonomics"
      },
      {
        "command": "tokenOptimizer.startTask",
        "title": "Tokonomics: Start Spend Task",
        "category": "Tokonomics"
      },
      {
        "command": "tokenOptimizer.endTask",
        "title": "Tokonomics: End Spend Task",
        "category": "Tokonomics"
      },
      {
        "command": "tokenOptimizer.setSpendBudget",
        "title": "Tokonomics: Set Spend Budget",
        "category": "Tokonomics"
      },
      {
        "command": "tokenOptimizer.recordTaskOutcome",
        "title": "Tokonomics: Rate Task Outcome",
        "category": "Tokonomics"
      },
      {
        "command": "tokenOptimizer.importClaudeUsage",
        "title": "Tokonomics: Import Claude Usage",
        "category": "Tokonomics"
      },
      {
        "command": "tokenOptimizer.watchClaudeUsage",
        "title": "Tokonomics: Watch Claude Usage Log",
        "category": "Tokonomics"
      },
      {
        "command": "tokenOptimizer.stopUsageWatcher",
        "title": "Tokonomics: Stop Usage Watcher",
        "category": "Tokonomics"
      },
      {
        "command": "tokenOptimizer.exportUsage",
        "title": "Tokonomics: Export Usage History",
        "category": "Tokonomics"
      },
      {
        "command": "tokenOptimizer.importPricing",
        "title": "Tokonomics: Import Pricing Snapshots",
        "category": "Tokonomics"
      },
      {
        "command": "tokenOptimizer.recommendModel",
        "title": "Tokonomics: Compare Available Model Costs",
        "category": "Tokonomics"
      },
      {
        "command": "tokenOptimizer.clearUsageHistory",
        "title": "Tokonomics: Clear Spend History",
        "category": "Tokonomics"
      },
      {
        "command": "tokenOptimizer.configureSubscriptionCli",
        "title": "Tokonomics: Configure subscription CLI"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "tokenOptimizer.showDashboard"
        },
        {
          "command": "tokenOptimizer.runContextXray",
          "when": "tokonomics.insights.contextXrayEnabled"
        },
        {
          "command": "tokenOptimizer.startContextMeter",
          "when": "tokonomics.insights.contextMeterEnabled && !tokonomics.insights.contextMeterActive"
        },
        {
          "command": "tokenOptimizer.stopContextMeter",
          "when": "tokonomics.insights.contextMeterEnabled && tokonomics.insights.contextMeterActive"
        },
        {
          "command": "tokenOptimizer.auditSessionHealth",
          "when": "tokonomics.insights.sessionHealthEnabled"
        },
        {
          "command": "tokenOptimizer.exportSessionHandoff",
          "when": "tokonomics.insights.sessionHandoffEnabled && tokonomics.chatSurfaceEnabled"
        },
        {
          "command": "tokenOptimizer.auditToolSchema",
          "when": "tokonomics.insights.toolSchemaAuditEnabled"
        },
        {
          "command": "tokenOptimizer.runFirstContextCheck",
          "when": "tokonomics.insights.firstContextCheckEnabled"
        },
        {
          "command": "tokenOptimizer.showAnalyticsWebview"
        },
        {
          "command": "tokenOptimizer.comparePrunedDiff"
        },
        {
          "command": "tokenOptimizer.optimizeSelection"
        },
        {
          "command": "tokenOptimizer.toggleAstPruning"
        },
        {
          "command": "tokenOptimizer.resetMetrics"
        },
        {
          "command": "tokenOptimizer.exportLogs"
        },
        {
          "command": "tokenOptimizer.liveStats"
        },
        {
          "command": "tokenOptimizer.aggregateStats"
        },
        {
          "command": "tokenOptimizer.explainTrace"
        },
        {
          "command": "tokenOptimizer.manageProjectMemory"
        }
      ],
      "editor/context": [
        {
          "command": "tokenOptimizer.comparePrunedDiff",
          "group": "AI@1"
        },
        {
          "command": "tokenOptimizer.optimizeSelection",
          "when": "editorHasSelection",
          "group": "AI@2"
        }
      ],
      "explorer/context": [
        {
          "command": "tokenOptimizer.comparePrunedDiff",
          "group": "AI"
        }
      ]
    },
    "configuration": {
      "title": "Tokonomics",
      "properties": {
        "tokenOptimizer.optimizationMode": {
          "type": "string",
          "enum": [
            "off",
            "balanced",
            "maximum"
          ],
          "enumDescriptions": [
            "Send the request without Tokonomics optimization.",
            "Use safe, quality-preserving optimization for everyday work.",
            "Use the strongest tested optimization while preserving required context."
          ],
          "default": "balanced",
          "description": "Choose how strongly Tokonomics optimizes AI context. Balanced is recommended."
        },
        "tokenOptimizer.workspaceContext": {
          "type": "string",
          "enum": [
            "none",
            "selection",
            "automatic"
          ],
          "enumDescriptions": [
            "Never add workspace-derived context.",
            "Use only text you explicitly select.",
            "Find relevant workspace context automatically in trusted workspaces."
          ],
          "default": "selection",
          "description": "Control whether Tokonomics may add workspace context. Workspace trust is always required."
        },
        "tokenOptimizer.includeUnsavedChanges": {
          "type": "boolean",
          "default": false,
          "description": "Allow explicitly selected unsaved editor text. Keep this off to avoid using unreviewed changes."
        },
        "tokenOptimizer.responseReuse": {
          "type": "boolean",
          "default": true,
          "description": "Reuse only exact, safe, completed responses for matching read-only requests."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "package": "node esbuild.js --production",
    "dev": "node esbuild.js",
    "test": "node scripts/run-tests.js",
    "certify:fast": "node scripts/run-tests.js",
    "certify": "node scripts/certify.js",
    "certify:deep": "node scripts/certify-deep.js",
    "certify:release": "node scripts/certify-release.js",
    "evaluate:phase10": "node scripts/evaluate-phase10.js",
    "verify:phase0": "node scripts/verify-phase0.js",
    "baseline:v7.0.1": "node scripts/generate-v7-phase0-baseline.js",
    "verify:vsix": "node scripts/verify-vsix.js",
    "qa:chat-panel": "node scripts/qa-chat-panel.js",
    "qa:chat-panel:installed": "node scripts/qa-installed-chat-panel.js",
    "verify:host:local": "node scripts/run-extension-host-matrix.js --local",
    "verify:host:all": "node scripts/run-extension-host-matrix.js --all",
    "generate:supply-chain": "node scripts/generate-supply-chain.js",
    "validate": "node scripts/validate.js",
    "validate:all": "node scripts/validate-all.js",
    "audit:clean-room": "node scripts/clean-room-audit.js",
    "measure:savings": "node scripts/measure-savings.js",
    "download-parsers": "node scripts/download-parsers.js",
    "vsce:package": "npx @vscode/vsce package --no-dependencies --out tokonomics-ai-8.4.0.vsix",
    "publish:vsce": "npx @vscode/vsce publish --no-dependencies",
    "publish:ovsx": "npx ovsx publish tokonomics-ai-8.4.0.vsix",
    "publish:all": "npm run publish:vsce && npm run publish:ovsx",
    "sync:public": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-public-repo.ps1",
    "measure:ablation": "node scripts/measure-ablation.js",
    "evaluate:tasks": "node scripts/evaluate-tasks.js",
    "test:finops": "node scripts/test-finops.js"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "0.3.1",
    "markdown-it": "14.3.1"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "^20.14.0",
    "@types/vscode": "1.106.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.5",
    "yauzl": "3.4.0"
  }
}
